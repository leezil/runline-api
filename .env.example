# Copy this file to .env and enter the Kakao JavaScript app key.
KAKAO_JAVASCRIPT_KEY=

# Public restroom importer only. Use the Decoding key from data.go.kr.
# Never put a real key in this example file or in a CLI argument.
PUBLIC_DATA_SERVICE_KEY=

# Separate Juso search and coordinate API approval keys (optional batch job).
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=
# Set true only after confirming storage and app redistribution for this use case.
JUSO_STORAGE_APPROVED=
